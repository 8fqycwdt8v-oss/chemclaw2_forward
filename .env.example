# --- Server ---
HOST=0.0.0.0
PORT=8765

# --- Model selection ---
# `*` means all registered predictors; or comma-list of IDs.
ENABLED_FORWARD_MODELS=*
ENABLED_CONDITIONS_MODELS=*
# Always-off list (wins over enabled).
DISABLED_MODELS=

# --- Compute ---
# 'cpu', 'cuda', 'cuda:0', or 'auto'.
DEVICE=auto
DEFAULT_TOP_K=5

# --- Caches ---
MODEL_CACHE_DIR=~/.cache/chemclaw2_forward
# Optional: redirect HuggingFace downloads
# HF_HOME=~/.cache/huggingface

# --- Anthropic Claude predictor (Phase C) ---
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_ID=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
CLAUDE_N_EXAMPLES=3

# --- Prediction cache (Phase D) ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# --- Mixture-of-Experts gating (Phase D) ---
USE_CLASS_PRIORS=true
# TRUST_PRIORS_PATH=~/.cache/chemclaw2_forward/trust_priors.json

# --- Per-model checkpoint paths (only needed for the model you install) ---
# T5CHEM_MODEL_PATH=/path/to/USPTO_500_MT/product
# MOLECULAR_TRANSFORMER_MODEL_PATH=/path/to/MIT_mixed_augm_model_average.pt
# CHEMFORMER_MODEL_PATH=/path/to/chemformer_forward
# MEGAN_MODEL_PATH=/path/to/megan_forward
# GRAPHRXN_MODEL_PATH=/path/to/graphrxn/model.pt
# PARROT_MODEL_PATH=/path/to/parrot/uspto_condition
# REAGENTS_MT_MODEL_PATH=/path/to/reagents-mt/model.pt
# TWO_STAGE_DNN_MODEL_PATH=/path/to/two_stage_dnn
# ASKCOS_CONTEXT_MODEL_PATH=/path/to/askcos/context_recommender_weights
